# Configuración de La Gema JARG74
# Copia este fichero a .env y sustituye los valores por los reales.
# OJO: cuando la app corre bajo Streamlit, .streamlit/secrets.toml tiene
# PRIORIDAD sobre este fichero. .env solo manda en scripts y tests que se
# ejecutan fuera de Streamlit.

# Código de acceso a la aplicación. Sin él la app no arranca (no hay valor
# por defecto a propósito).
ACCESS_CODE=TU_CODIGO_DE_ACCESO_AQUI

# Llaves de las APIs de datos
API_FOOTBALL_KEY=TU_LLAVE_DE_API_SPORTS_AQUI
FOOTBALL_DATA_API_KEY=TU_LLAVE_DE_FOOTBALL_DATA_AQUI
SPORTMONKS_API_TOKEN=TU_TOKEN_DE_SPORTMONKS_AQUI
