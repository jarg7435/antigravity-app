# Plantilla de secretos para Streamlit — La Gema JARG74
#
# LOCAL: copia este fichero a .streamlit/secrets.toml y pon los valores reales.
#        secrets.toml está en .gitignore y NUNCA debe subirse.
# CLOUD: pega este mismo contenido en share.streamlit.io → tu app →
#        Settings → Secrets.
#
# Streamlit vuelca estos valores también a os.environ, y SOBREESCRIBE lo que
# venga de .env. Es decir: bajo Streamlit, este fichero es la fuente de verdad.

ACCESS_CODE = "TU_CODIGO_DE_ACCESO_AQUI"

API_FOOTBALL_KEY = "TU_LLAVE_DE_API_SPORTS_AQUI"
FOOTBALL_DATA_API_KEY = "TU_LLAVE_DE_FOOTBALL_DATA_AQUI"
SPORTMONKS_API_TOKEN = "TU_TOKEN_DE_SPORTMONKS_AQUI"
